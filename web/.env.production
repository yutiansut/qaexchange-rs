# 生产环境配置
# @yutiansut @quantaxis

# WebSocket 服务器地址 (DIFF 协议)
# 本地开发使用 localhost，生产部署修改为实际IP
VUE_APP_WS_URL=ws://localhost:8095/ws/diff

# 默认订阅的合约（逗号分隔）
# ✨ 添加 CFFEX.IF2501 以支持K线数据展示 @yutiansut @quantaxis
# 默认订阅的合约。@yutiansut @quantaxis
# ⚠️ 三条约束(2026-09-04 实测踩过):
#   ① **不带交易所前缀** —— 后端 instrument_id 就是 `IF2501`,
#      写成 `CFFEX.IF2501` 会订阅到一个不存在的 key;
#   ② 只写**本部署真实注册**的合约 —— 原先的 SHFE.cu2501 / SHFE.ag2506
#      在后端根本没注册(main.rs 只注册 IF2501/IF2502/IC2501/IH2501),
#      4 条订阅白白浪费 2 条;
#   ③ 要覆盖图表页下拉的全部合约 —— 否则未被订阅的合约
#      K线图只有 HTTP 历史、之后完全静止(实测 IC2501 75 秒收到 0 根增量)。
VUE_APP_DEFAULT_INSTRUMENTS=IF2501,IF2502,IC2501,IH2501

# API 基础 URL
# 本地开发使用 localhost，生产部署修改为实际IP
VUE_APP_API_BASE_URL=http://localhost:8094/api
